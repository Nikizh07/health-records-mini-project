    {
      "name": "04. Appointment Module",
      "item": [
        {
          "name": "1. Book Appointment (Patient)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set a unique future slot time (tomorrow 10:00 AM UTC)",
                  "var tomorrow = new Date();",
                  "tomorrow.setDate(tomorrow.getDate() + 1);",
                  "tomorrow.setUTCHours(10, 0, 0, 0);",
                  "pm.environment.set(\"slot_time\", tomorrow.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set(\"appointment_id\", json.data.id);",
                  "    console.log(\"Saved appointment_id:\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
