              "raw": "{{base_url}}/api/appointments?doctor_id={{doctor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments"],
              "query": [
                {
                  "key": "doctor_id",
                  "value": "{{doctor_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "5. Reschedule Appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var newTime = new Date();",
                  "newTime.setDate(newTime.getDate() + 2);",
                  "newTime.setUTCHours(14, 30, 0, 0);",
                  "pm.environment.set(\"rescheduled_slot_time\", newTime.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patient_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_time\": \"{{rescheduled_slot_time}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/appointments/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments", "{{appointment_id}}"]
            }
          }
        },
        {
          "name": "6. Cancel Appointment (Soft Cancel)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Appointment status is cancelled\", function () {",
                  "    pm.expect(json.data.status).to.eql(\"cancelled\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patient_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/appointments/{{appointment_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments", "{{appointment_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Medical Records & Prescriptions",
