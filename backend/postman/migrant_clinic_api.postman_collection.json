    {
      "name": "03. Patient Module",
      "item": [
        {
          "name": "1. Register Patient Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"patient_id\", json.data.id);",
                  "    pm.environment.set(\"patient_health_id\", json.data.health_id);",
                  "    console.log(\"Registered patient_id:\", json.data.id);",
                  "    console.log(\"Generated health_id:\", json.data.health_id);",
                  "} else if (pm.response.code === 400 && pm.response.json().patient_id) {",
                  "    // In case already registered in previous run",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"patient_id\", json.patient_id);",
                  "    pm.environment.set(\"patient_health_id\", json.health_id);",
                  "    console.log(\"Existing patient_id loaded:\", json.patient_id);",
                  "}",
                  "pm.test(\"Patient registered or already exists\", function () {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patient_token}}",
                  "type": "string"
