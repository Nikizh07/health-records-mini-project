// prisma/schema.prisma
// Prisma Schema for Migrant Worker Clinics System
// NOTE: Database URL is configured in prisma/prisma.config.ts (Prisma v7+)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------
enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  CLINIC_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum InteractionSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

// ------------------------------------------------------------
// 0. User Entity (Authentication & Role Mapping)
// ------------------------------------------------------------
model User {
  id           String   @id @default(uuid()) @db.Uuid
  firebase_uid String     @unique
  phone        String?    @unique
  email        String?    @unique
  role         Role       @default(PATIENT)
  status       UserStatus @default(ACTIVE)
  clinic_id    String?    @db.Uuid
  created_at   DateTime   @default(now())

  patient Patient?
  doctor  Doctor?
  clinic  Clinic?  @relation(fields: [clinic_id], references: [id], onDelete: SetNull)

  invites_sent     StaffInvite[] @relation("InvitedBy")
  invite_accepted  StaffInvite?  @relation("AcceptedBy")
  doctors_verified Doctor[]      @relation("VerifiedBy")

  @@map("users")
}

// ------------------------------------------------------------
// 1. Patient Entity
// ------------------------------------------------------------
model Patient {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String?  @unique @db.Uuid
  health_id     String   @unique
  name          String
  phone         String   @unique
  dob           DateTime
  gender        String
  language_pref String
  created_at    DateTime @default(now())

  // Desk registration (Auth Phase 5): staff create the profile with no account
  // (user_id null); the patient claims it later by phone OTP + date of birth.
  // Audit only, no FK, so removing a staff user never blocks on it.
  registered_by_user_id String?   @db.Uuid
  claim_failures        Int       @default(0)
  claim_locked_until    DateTime?

  user               User?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  medical_records    MedicalRecord[]
  interaction_checks InteractionCheck[]

  @@map("patients")
}

// ------------------------------------------------------------
// 2. Clinic Entity
// ------------------------------------------------------------
model Clinic {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  location       String
  contact_number String
  latitude       Float?
  longitude      Float?
  created_at     DateTime @default(now())

  doctors      Doctor[]
  appointments Appointment[]
  users        User[]
  staff_invites StaffInvite[]

  @@map("clinics")
}

// ------------------------------------------------------------
// 3. Doctor Entity
// ------------------------------------------------------------
model Doctor {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String?  @unique @db.Uuid
  clinic_id      String   @db.Uuid
  name           String
  specialization String
  phone          String?  @unique
  email          String?  @unique
  // Self-applied doctors: checked by hand against the council register.
  registration_number  String?
  registration_council String?
  verified_at          DateTime?
  verified_by_id       String?   @db.Uuid
  created_at     DateTime @default(now())

  user               User?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  verified_by        User?              @relation("VerifiedBy", fields: [verified_by_id], references: [id], onDelete: SetNull)
  clinic             Clinic             @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  medical_records    MedicalRecord[]
  interaction_checks InteractionCheck[]

  @@map("doctors")
}

// ------------------------------------------------------------
// 4. Appointment Entity
// ------------------------------------------------------------
model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  patient_id String            @db.Uuid
  doctor_id  String            @db.Uuid
  clinic_id  String            @db.Uuid
  slot_time  DateTime
  status     AppointmentStatus @default(pending)
  created_at DateTime          @default(now())

  patient         Patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor          Doctor          @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  clinic          Clinic          @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  medical_records MedicalRecord[]

  @@map("appointments")
}

// ------------------------------------------------------------
// 5. Medical Record Entity
// ------------------------------------------------------------
model MedicalRecord {
  id              String   @id @default(uuid()) @db.Uuid
  patient_id      String   @db.Uuid
  doctor_id       String   @db.Uuid
  appointment_id  String?  @db.Uuid
  visit_date      DateTime
  diagnosis       String   @db.Text
  notes           String   @db.Text
  report_file_url String?
  created_at      DateTime @default(now())

  patient            Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor             Doctor             @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  appointment        Appointment?       @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  prescriptions      Prescription[]
  interaction_checks InteractionCheck[]

  @@index([patient_id])
  @@map("medical_records")
}

// ------------------------------------------------------------
// 6. Prescription Entity
// ------------------------------------------------------------
model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  record_id     String   @db.Uuid
  medicine_name String
  dosage        String
  duration      String
  created_at    DateTime @default(now())

  medical_record MedicalRecord @relation(fields: [record_id], references: [id], onDelete: Cascade)

  @@index([record_id])
  @@map("prescriptions")
}

// ------------------------------------------------------------
// 7. Drug Interaction Reference (curated, seeded)
// ------------------------------------------------------------
// Authoritative list of known dangerous drug pairs. Populated by
// scripts/seed-drug-interactions.js — never written by the app.
// Names are stored normalised (lowercase generic, no strength/form),
// always with drug_a < drug_b so a pair has exactly one row.
// ------------------------------------------------------------
model DrugInteraction {
  id                    String              @id @default(uuid()) @db.Uuid
  drug_a                String
  drug_b                String
  severity              InteractionSeverity
  mechanism             String              @db.Text
  suggested_alternative String?
  created_at            DateTime            @default(now())

  @@unique([drug_a, drug_b])
  @@index([drug_a])
  @@index([drug_b])
  @@map("drug_interactions")
}

// ------------------------------------------------------------
// 8. Interaction Check (audit trail)
// ------------------------------------------------------------
// One row per pre-flight check run before a visit record is saved.
// Server-side source of truth for what the doctor was shown, so an
// override reason can be verified against real conflicts.
// ------------------------------------------------------------
model InteractionCheck {
  id              String   @id @default(uuid()) @db.Uuid
  patient_id      String   @db.Uuid
  doctor_id       String   @db.Uuid
  record_id       String?  @db.Uuid
  checked_drugs   Json
  conflicts       Json
  ai_available    Boolean  @default(false)
  ai_provider     String?
  overridden      Boolean  @default(false)
  override_reason String?  @db.Text
  created_at      DateTime @default(now())

  patient Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  Doctor         @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  record  MedicalRecord? @relation(fields: [record_id], references: [id], onDelete: SetNull)

  @@index([patient_id])
  @@map("interaction_checks")
}

// ------------------------------------------------------------
// 9. Staff Invite
// ------------------------------------------------------------
// An admin invites a person (by email and/or phone) to a role at a clinic.
// Accepted on the invitee's first GET /patients/me, only when the matching
// identifier is verified on their Firebase account.
// ------------------------------------------------------------
model StaffInvite {
  id               String   @id @default(uuid()) @db.Uuid
  clinic_id        String   @db.Uuid
  role             Role
  email            String?
  phone            String?
  name             String
  specialization   String?
  invited_by_id    String?  @db.Uuid // null for invites created by the migration for legacy doctors
  accepted_user_id String?  @unique @db.Uuid
  expires_at       DateTime
  created_at       DateTime @default(now())

  clinic        Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  invited_by    User?  @relation("InvitedBy", fields: [invited_by_id], references: [id], onDelete: SetNull)
  accepted_user User?  @relation("AcceptedBy", fields: [accepted_user_id], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([phone])
  @@map("staff_invites")
}
