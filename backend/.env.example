# ============================================================
# .env.example — Environment Variable Template
# ============================================================
# Copy this file to '.env' and fill in your real values.
# NEVER commit your actual .env file — it is git-ignored.
#
#   cp .env.example .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
# Port the Express server listens on locally
PORT=3000

# Node environment: 'development', 'test', or 'production'
NODE_ENV=development

# ── PostgreSQL (Amazon RDS) ──────────────────────────────────
# Full connection string for your PostgreSQL database.
# Local development format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# RDS (TLS verified against the CA bundle baked into the image):
#   postgresql://USER:PASSWORD@<rds-endpoint>:5432/migrant_clinic_db?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem
# In production this comes from AWS Secrets Manager, not from a file.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/migrant_clinic_db

# ── Firebase Authentication ──────────────────────────────────
# Found in: Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to your Firebase Admin SDK service account JSON key file.
# Download from: Firebase Console → Project Settings → Service Accounts
# WARNING: Never commit this file. It is already git-ignored via 'firebase-adminsdk*.json'
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-adminsdk.json

# Alternative to the path above, for hosts where the key file is not on disk
# (the Dockerfile ignores it, so it is never in the image). Paste the whole
# JSON, or its base64. Takes priority over FIREBASE_SERVICE_ACCOUNT_PATH.
#   FIREBASE_SERVICE_ACCOUNT_JSON=
#   FIREBASE_SERVICE_ACCOUNT_JSON=$(base64 -w0 config/firebase-adminsdk.json)

# ── AWS (region + report storage) ────────────────────────────
# Region for S3 (and Bedrock/SageMaker, if the AI leg uses them)
AWS_REGION=ap-south-1

# Private S3 bucket holding uploaded reports. Objects are never public —
# the API hands out 15-minute presigned URLs. Credentials come from the AWS
# chain: the ECS task role in production, AWS_PROFILE locally.
S3_BUCKET_NAME=migrant-clinic-reports-yoursuffix

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
# Example: https://your-frontend.web.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=yourpassword

# ── AI drug-interaction check (optional) ─────────────────────
# Any OpenAI-compatible endpoint, AWS Bedrock or AWS SageMaker. Leave
# unconfigured (or AI_ENABLED=false) and the check uses the curated table only.
# Smoke-test a provider: node scripts/test-ai-provider.js
AI_ENABLED=true
AI_PROVIDER=openai-compatible        # openai-compatible | bedrock | sagemaker
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=1500

# openai-compatible: OpenAI, Gemini, Groq, OpenRouter, Ollama, vLLM, LM Studio…
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_JSON_MODE=true
#   Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq   : AI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama : AI_BASE_URL=http://localhost:11434/v1   (AI_API_KEY can be any non-empty string)

# bedrock: credentials come from the AWS chain (AWS_PROFILE locally, ECS task role in prod)
# AI_PROVIDER=bedrock
# AWS_REGION=ap-south-1
# AI_MODEL=<from: aws bedrock list-foundation-models --region ap-south-1 --by-provider meta>

# sagemaker: payload mapping targets the HuggingFace TGI container (services/ai/providers/sagemaker.js)
# AI_PROVIDER=sagemaker
# AWS_REGION=ap-south-1
# AI_SAGEMAKER_ENDPOINT=my-llama-endpoint

# ── Text-to-Speech (Smart Prescriptions Phase 4) ─────────────
# Voice synthesis for patient prescription messages. Three providers available:
#   mock   — always available, returns a silent 1-second WAV (no credentials needed)
#   google — Google Cloud Text-to-Speech REST API
#   polly  — AWS Polly via SDK (uses default AWS credential chain)
# Smoke-test a provider: node scripts/test-tts-provider.js
TTS_ENABLED=true
TTS_PROVIDER=mock                    # mock | google | polly
TTS_TIMEOUT_MS=30000

# mock: no configuration needed, always works

# google: REST API with an API key (no SDK required)
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=
# TTS_VOICE_EN=en-IN-Standard-A      # Indian English voice (optional, shown are defaults)
# TTS_VOICE_HI=hi-IN-Standard-A      # Hindi voice
# TTS_VOICE_TA=ta-IN-Standard-A      # Tamil voice
#   Verify voices: curl "https://texttospeech.googleapis.com/v1/voices?key=YOUR_KEY" | jq '.voices[] | select(.languageCodes[] | contains("ta-IN"))'

# polly: credentials come from the AWS chain (AWS_PROFILE locally, ECS task role in prod)
# TTS_PROVIDER=polly
# AWS_REGION=ap-south-1
# TTS_VOICE_EN=Kajal                 # Indian English female voice (optional, shown are defaults)
# TTS_VOICE_HI=Aditi                 # Hindi female voice
# TTS_VOICE_TA=                      # Tamil voice — must verify availability first
#   Verify voices: aws polly describe-voices --region ap-south-1 --language-code ta-IN
#   Note: If Tamil is unavailable, patients with ta preference will receive English audio.

# ── Media Serving & Security (Smart Prescriptions Phase 4) ───
# JWT secret for signing media tokens. Patient message assets (audio, images)
# are served via /api/media/:token/:filename with 15-minute expiry.
# This should be a long random string. Generate one with:
#   openssl rand -base64 32
# SECURITY: Replace this placeholder before deploying!
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_GENERATE_WITH_OPENSSL

# Public base URL of this API server. Required for Twilio Sandbox to fetch media.
# Local development with ngrok:
#   PUBLIC_BASE_URL=https://your-ngrok-id.ngrok.io
# Production (Render, Heroku, custom domain):
#   PUBLIC_BASE_URL=https://your-app.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# ── Messaging Provider (Smart Prescriptions Phase 5) ─────────
# Delivers patient prescription messages via WhatsApp. Three providers available:
#   log            — writes to .scratch/messages/ (no credentials, pure local dev)
#   twilio-sandbox — Twilio WhatsApp Sandbox (requires Twilio account)
#   meta-cloud     — Meta WhatsApp Cloud API (recommended, free dev tier)
# Smoke-test: node scripts/test-messaging-provider.js
MSG_PROVIDER=log                     # log | twilio-sandbox | meta-cloud

# log: no configuration needed, writes to backend/.scratch/messages/

# meta-cloud: Meta WhatsApp Cloud API (recommended — no paid plan needed for dev)
# MSG_PROVIDER=meta-cloud
# META_PHONE_NUMBER_ID=your_numeric_phone_number_id
# META_ACCESS_TOKEN=your_access_token
# META_API_VERSION=v19.0              # optional, defaults to v19.0
#   Setup instructions:
#   1. Go to https://developers.facebook.com → Create App → Business → WhatsApp
#   2. Under WhatsApp → API Setup, copy Phone Number ID and temporary access token
#   3. Add up to 5 recipient numbers under "To" (your test numbers)
#   4. For a permanent token: Business Settings → System Users → generate token
#      with whatsapp_business_messaging permission

# twilio-sandbox: Twilio WhatsApp Sandbox for testing
# MSG_PROVIDER=twilio-sandbox
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_SANDBOX_NUMBER=whatsapp:+14155238886
#   Setup instructions:
#   1. Sign up for Twilio account: https://www.twilio.com/try-twilio
#   2. Go to Console → Messaging → Try it out → Send a WhatsApp message
#   3. Copy your Account SID, Auth Token, and Sandbox number
#   4. Patient must send "join <sandbox-name>" to the Twilio number first (one-time)
#   5. For local testing, expose your server with ngrok:
#      ngrok http 3000
#      Then set PUBLIC_BASE_URL=https://your-ngrok-id.ngrok.io
#   6. Production: Use your actual domain as PUBLIC_BASE_URL
#
#   Note: Sandbox limitations:
#   - Users must send "join <sandbox-name>" before receiving messages
#   - For production, upgrade to WhatsApp Business API (requires approval)
